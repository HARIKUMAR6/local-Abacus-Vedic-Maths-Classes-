{
  "name": "sutrabead-academy",
  "version": "1.1.0",
  "private": true,
  "description": "SutraBead Abacus & Vedic Maths Academy website",
  "scripts": {
    "build:pages": "node src/build.js",
    "build:css": "node node_modules/tailwindcss/lib/cli.js -c tailwind.config.js -i src/tailwind.css -o assets/css/tailwind.css --minify",
    "build": "npm run build:pages && npm run build:css",
    "watch:css": "node node_modules/tailwindcss/lib/cli.js -c tailwind.config.js -i src/tailwind.css -o assets/css/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
